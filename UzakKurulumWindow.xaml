                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="📂 Ağ Paylaşım Yönetimi" FontWeight="Bold" Foreground="#1E293B" FontSize="14"/>
                                                                <TextBlock Text="Uzak PC'deki ağ paylaşımlarını WMI ile listeler." FontSize="11" Foreground="Gray" FontStyle="Italic"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" x:Name="btnGetShares" Click="btnGetShares_Click" Content="🔄 Paylaşımları Getir" Width="155" Height="35" VerticalAlignment="Center" Margin="10,0,0,0"
                                                                    Background="#6366F1" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                                                <Button.Resources>
                                                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                                                                </Button.Resources>
                                                            </Button>
                                                        </Grid>
                                                        <DataGrid Grid.Row="1" x:Name="gridShares" AutoGenerateColumns="False" CanUserAddRows="False"
                                                                  HeadersVisibility="Column" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9">
                                                            <DataGrid.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="📂 UNC Yoluyla Aç" Click="MenuOpenShare_Click"/>
                                                                    <MenuItem Header="📋 UNC Yolunu Kopyala" Click="MenuCopyShareUNC_Click"/>
                                                                </ContextMenu>
                                                            </DataGrid.ContextMenu>
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Binding="{Binding Name}" Header="Paylaşım Adı" Width="*" IsReadOnly="True" FontWeight="Bold"/>
                                                                <DataGridTextColumn Binding="{Binding Path}" Header="Gerçek Yol" Width="2*" IsReadOnly="True"/>
                                                                <DataGridTextColumn Binding="{Binding ShareType}" Header="Tür" Width="65" IsReadOnly="True"/>
                                                                <DataGridTextColumn Binding="{Binding Description}" Header="Açıklama" Width="100" IsReadOnly="True"/>
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </Grid>
                                                </Border>
                                            </TabItem>

                                            <!-- Tab 3: Servis Yöneticisi -->
                                            <TabItem Header="🔧 Servis Yöneticisi">
                                                <Border Background="White" CornerRadius="0,8,8,8" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        
                                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="🔧 Uzak Servis Yöneticisi" FontWeight="Bold" Foreground="#1E293B" FontSize="14"/>
                                                                <TextBlock Text="Uzak bilgisayardaki Windows servislerini WMI ile yönetir." FontSize="11" Foreground="Gray" FontStyle="Italic"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" x:Name="btnGetServices" Click="btnGetServices_Click" Content="🔄 Servisleri Getir" Width="140" Height="35" VerticalAlignment="Center" Margin="10,0,0,0"
                                                                    Background="#8B5CF6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                                                <Button.Resources>
                                                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                                                                </Button.Resources>
                                                            </Button>
                                                        </Grid>
                                                        
                                                        <Grid Grid.Row="1" Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="120"/>
