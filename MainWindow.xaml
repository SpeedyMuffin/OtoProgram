<Window x:Class="OtoProgram.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OtoProgram" 
        mc:Ignorable="d"
        Title="Otomasyon Kurulum &amp; Domain Asistanı v3.6" 
        Height="850" Width="1400" 
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize" 
        FontFamily="Segoe UI"
        MouseDown="Window_MouseDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:MessageAlignmentConverter x:Key="AlignmentConverter"/>
        <local:MessageAlignmentConverter x:Key="MessageAlignmentConverter"/>
        <local:OnlineColorConverter x:Key="OnlineColorConverter"/>

        <Style x:Key="LoginTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>

        <Style x:Key="LoginPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="15,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="24" Width="48" Height="48">
                            <TextBlock Text="&#xE725;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BuzzButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFF7ED"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="8">
                            <Path Data="M13.5,2C13.5,2.9 13.1,3.7 12.4,4.4L11,5.8V17L12.4,18.4C13.1,19.1 13.5,19.9 13.5,20.8V22H2.5V20.8C2.5,19.9 2.9,19.1 3.6,18.4L5,17V5.8L3.6,4.4C2.9,3.7 2.5,2.9 2.5,2H13.5M8,0L8.4,0.1C9.6,0.4 10.7,1 11.6,1.9L13,3.3C14.3,4.6 15,6.3 15,8.1V15.9C15,17.7 14.3,19.4 13,20.7L11.6,22.1C10.7,23 9.6,23.6 8.4,23.9L8,24H8V0M8,6V18L10,20H6L8,18V6Z" 
                                  Fill="#FF8F00" Width="20" Height="20" Stretch="Uniform"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFEDD5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder" Background="Transparent" CornerRadius="20">
        <Grid>
            <StackPanel x:Name="WindowControls" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,15,0" Panel.ZIndex="1001">
                <Button Content="─" Style="{StaticResource WindowControlButtonStyle}" Width="40" Height="40" Margin="0,0,10,0" Click="BtnMinimize_Click" FontSize="18"/>
                <Button x:Name="btnMaximize" Content="⬜" Style="{StaticResource WindowControlButtonStyle}" Width="40" Height="40" Margin="0,0,10,0" Click="BtnMaximize_Click" FontSize="14"/>
                <Button Content="✕" Style="{StaticResource CloseButtonStyle}" Width="40" Height="40" Click="BtnClose_Click" FontSize="18"/>
            </StackPanel>

            <Border x:Name="LoginGrid" Background="White" Width="400" Height="650" CornerRadius="20" 
                    VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible" Panel.ZIndex="10">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="15" Opacity="0.2" BlurRadius="50"/>
                </Border.Effect>

                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,20,0">
                        <Button Content="─" Style="{StaticResource WindowControlButtonStyle}" Width="30" Height="30" Margin="0,0,5,0" Click="BtnMinimize_Click" Background="Transparent"/>
                        <Button Content="✕" Style="{StaticResource CloseButtonStyle}" Width="30" Height="30" Click="BtnClose_Click" Background="Transparent"/>
                    </StackPanel>

                    <StackPanel Margin="50,40">
                        <StackPanel Margin="0,0,0,40">
                            <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8Z" 
                                  Fill="#2563EB" Height="70" Width="70" HorizontalAlignment="Center" Margin="0,0,0,15" Stretch="Uniform"/>
                            <TextBlock Text="OTOPROGRAM" HorizontalAlignment="Center" FontSize="26" FontWeight="Bold" Foreground="#1E293B"/>
                            <TextBlock Text="Yönetim Paneli v3.6" HorizontalAlignment="Center" FontSize="16" Foreground="#64748B"/>
                        </StackPanel>

                        <TextBlock Text="Kullanıcı Adı" Foreground="#64748B" FontSize="14" Margin="5,0,0,5" FontWeight="SemiBold"/>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="10" Height="50" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" 
                                      Fill="#94A3B8" Height="22" Width="22" Stretch="Uniform"/>
                                <TextBox x:Name="txtKullanici" Grid.Column="1" Style="{StaticResource LoginTextBox}" KeyDown="txtKullanici_KeyDown" Margin="0,0,10,0"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Şifre" Foreground="#64748B" FontSize="14" Margin="5,0,0,5" FontWeight="SemiBold"/>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="10" Height="50" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z" 
                                      Fill="#94A3B8" Height="22" Width="22" Stretch="Uniform"/>
                                <PasswordBox x:Name="txtSifre" Grid.Column="1" Style="{StaticResource LoginPasswordBox}" KeyDown="txtSifre_KeyDown" Margin="0,0,10,0"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Domain" Foreground="#64748B" FontSize="14" Margin="5,0,0,5" FontWeight="SemiBold"/>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="10" Height="50" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M11,7H13V9H11V7M11,11H13V17H11V11Z"
                                      Fill="#94A3B8" Height="22" Width="22" Stretch="Uniform"/>
                                <ComboBox x:Name="cmbLoginDomain" Grid.Column="1" IsEditable="True" Text="domain.local" 
                                          Background="Transparent" BorderThickness="0" FontSize="16" VerticalContentAlignment="Center"
                                          Foreground="#333" Margin="0,0,10,0">
                                    <ComboBoxItem Content="domain.local"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Button x:Name="btnGiris" Content="Sisteme Giriş Yap" Height="55" Click="btnGiris_Click" Background="#2563EB" Style="{StaticResource ModernButtonStyle}" FontSize="18"/>

                        <Button x:Name="btnDemoGiris" Content="🔓 Demo Modu ile Giriş" Height="45" Click="btnDemoGiris_Click" 
                                Background="#10B981" Style="{StaticResource ModernButtonStyle}" FontSize="14" Margin="0,10,0,0" 
                                ToolTip="Ağ bağlantısı olmadan uygulamayı keşfedin"/>

                        <StackPanel Margin="0,20,0,0">
                            <Separator Background="#F1F5F9" Margin="10,0"/>
                            <TextBlock Text="harikalar yaratan otomasyon" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,10,0,0" 
                                       FontSize="13" 
                                       FontWeight="Bold" 
                                       Foreground="#FF8F00" 
                                       FontStyle="Italic">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FFB300" BlurRadius="8" ShadowDepth="1" Opacity="0.5"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <Button x:Name="btnInstagramLogin" Click="btnInstagram_Click" Content="📸 Destek &amp; İletişim (@cikolatalidondurma35)"
                                    Margin="0,8,0,0" Height="30" FontSize="11" FontWeight="SemiBold"
                                    Background="#E1306C" Foreground="White" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="15"/></Style>
                                </Button.Resources>
                            </Button>
                            <TextBlock Text="🏢 Şirketinize, kurumunuza veya ağınıza özel otomasyon kurulumları ve destek talepleri için Instagram üzerinden yazabilirsiniz."
                                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" FontSize="10.5" 
                                       Foreground="#64748B" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="MainGrid" Visibility="Collapsed" Margin="25,40,25,25" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="MainGridScale" ScaleX="0.95" ScaleY="0.95"/>
                </Grid.RenderTransform>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="colMusic" Width="0"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="colChat" Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="20" Margin="0,0,25,0" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="🎵 Müzik Merkezi" FontSize="22" FontWeight="Bold" Foreground="#1A1D21"/>
                            <TextBlock Text="Kişisel Müzik Havuzu" FontSize="12" Foreground="#78909C"/>
                        </StackPanel>
                        <Border Grid.Row="1" Background="#F8F9FB" CornerRadius="12" Margin="0,0,0,20" Padding="10">
                            <ListBox x:Name="lstMusicSources" Height="100" BorderThickness="0" Background="Transparent" SelectionChanged="lstMusicSources_SelectionChanged"/>
                        </Border>
                        <Border Grid.Row="2" BorderThickness="1.5" BorderBrush="#ECEFF1" CornerRadius="12" Padding="5">
                            <TreeView x:Name="treeMusicLibrary" BorderThickness="0" Background="Transparent" MouseDoubleClick="treeMusicLibrary_MouseDoubleClick">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Tracks}">
                                        <StackPanel Orientation="Horizontal" Margin="5">
                                            <TextBlock Text="📁 " Foreground="#FBC02D" FontSize="16"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                        </StackPanel>
                                        <HierarchicalDataTemplate.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="5">
                                                    <TextBlock Text="🎵 " Foreground="#78909C"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="13"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </HierarchicalDataTemplate.ItemTemplate>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Border>
                        <StackPanel Grid.Row="3" Margin="0,20,0,0">
                            <Canvas x:Name="canvMarquee" Height="30" Width="280" ClipToBounds="True" HorizontalAlignment="Center">
                                <TextBlock x:Name="lblNowPlaying" Text="Şarkı Seçilmedi" FontSize="14" Foreground="#007ACC" FontWeight="Bold" Canvas.Left="0" Canvas.Top="4"/>
                            </Canvas>
                            <StackPanel Margin="0,10,0,15">
                                <Grid>
                                    <TextBlock x:Name="lblCurrentTime" Text="00:00" FontSize="11" Foreground="#78909C" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="lblTotalTime" Text="00:00" FontSize="11" Foreground="#78909C" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="sldMusicProgress" Minimum="0" Maximum="100" Margin="0,5,0,0" Cursor="Hand" IsMoveToPointEnabled="True" PreviewMouseLeftButtonDown="sldMusicProgress_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="sldMusicProgress_PreviewMouseLeftButtonUp" ValueChanged="sldMusicProgress_ValueChanged"/>
                            </StackPanel>
                            <Slider x:Name="sldVolumeMusic" Minimum="0" Maximum="1" Value="0.5" ValueChanged="sldVolumeMusic_ValueChanged" Margin="0,0,0,15"/>
                            <UniformGrid Columns="2">
                                <Button Content="▶ Oynat" Click="btnPlay_Click" Background="#2E7D32" Style="{StaticResource ModernButtonStyle}" Margin="0,0,10,0" Height="45" FontSize="14"/>
                                <Button Content="⏸ Durdur" Click="btnPause_Click" Background="#C62828" Style="{StaticResource ModernButtonStyle}" Height="45" FontSize="14"/>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,25,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="300"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="20" Padding="25" Margin="0,0,0,20">
                        <Grid>
                            <DockPanel LastChildFill="True">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock x:Name="lblGreeting" Text="Hoş geldiniz" FontSize="28" FontWeight="Bold" Foreground="#263238"/>
                                        <TextBlock Text="Kategori Bazlı Uygulama Yönetimi" FontSize="14" Foreground="#78909C" Margin="2,5,0,0"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,25,0">
                                        <TextBlock Text="Destek / Özel Kurulum Talepleri için:" VerticalAlignment="Center" Foreground="#64748B" FontSize="12" Margin="0,0,8,0" FontWeight="SemiBold"/>
                                        <Button x:Name="btnInstagramMain" Click="btnInstagram_Click" Background="#E1306C" Margin="0,0,10,0" Width="50" Height="50" Style="{StaticResource IconButtonStyle}" ToolTip="Yapımcıya Ulaş (@cikolatalidondurma35) - Özel otomasyon kurulumu ve ağ destek talepleri için tıklayın">
                                            <TextBlock Text="📷" FontSize="22" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Button>

                                        <Button x:Name="btnSettings" Click="btnSettings_Click" Background="#64748B" Margin="0,0,10,0" Width="50" Height="50" Style="{StaticResource IconButtonStyle}" ToolTip="Sistem Ayarları">
                                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="24"/>
                                        </Button>

                                        <Button x:Name="btnToggleRecent" Click="btnRecentToggle_Click" Background="#F59E0B" Margin="0,0,10,0" Width="50" Height="50" Style="{StaticResource IconButtonStyle}" ToolTip="Son İşlemler / Hızlı Erişim">
                                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="24"/>
                                        </Button>

                                        <Button x:Name="btnToggleMusic" Click="btnToggleMusic_Click" Background="#673AB7" Margin="0,0,10,0" Width="50" Height="50" Style="{StaticResource IconButtonStyle}" ToolTip="Müzik">
                                            <TextBlock Text="&#xEC4F;" FontFamily="Segoe MDL2 Assets" FontSize="24"/>
                                        </Button>

                                        <Button x:Name="btnToggleChat" Click="btnChatToggle_Click" Background="#007ACC" Width="50" Height="50" Style="{StaticResource IconButtonStyle}" ToolTip="Sohbet">
                                            <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="24"/>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                                    <ItemsControl x:Name="itemsKategoriler">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F8F9FB" BorderBrush="#ECEFF1" BorderThickness="1.5" CornerRadius="15" Width="300" Margin="0,0,20,20" Padding="15" VerticalAlignment="Top">
                                                    <StackPanel>
                                                        <Grid Background="Transparent" MouseLeftButtonDown="CategoryHeader_MouseLeftButtonDown" Cursor="Hand">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                <CheckBox.LayoutTransform>
                                                                    <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
                                                                </CheckBox.LayoutTransform>
                                                            </CheckBox>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand">
                                                                    <ToggleButton.Template>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <TextBlock Text="▶" FontSize="14" Foreground="#90A4AE" VerticalAlignment="Center"/>
                                                                        </ControlTemplate>
                                                                    </ToggleButton.Template>
                                                                </ToggleButton>
                                                                <TextBlock Text="📁" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding CategoryName}" FontSize="15" FontWeight="Bold" Foreground="#37474F" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="2" Background="#4CAF50" CornerRadius="6" Padding="8,4" Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock Text="OK" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                                            </Border>
                                                        </Grid>
                                                        <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Separator Background="#ECEFF1" Margin="0,12,0,10"/>
                                                            <ItemsControl ItemsSource="{Binding Apps}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="White" Margin="0,3" CornerRadius="8" Padding="10,8" BorderThickness="1" BorderBrush="#F0F2F5">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="2,0,12,0">
                                                                                    <CheckBox.LayoutTransform>
                                                                                        <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                                                                    </CheckBox.LayoutTransform>
                                                                                </CheckBox>
                                                                                <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="13" Foreground="#546E7A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                                <Border Grid.Column="2" Background="#E8F5E9" CornerRadius="5" Padding="6,2" Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                    <TextBlock Text="✔" Foreground="#2E7D32" FontWeight="Bold" FontSize="12"/>
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#0D1117" CornerRadius="20" Padding="20" Margin="0,0,0,20" BorderThickness="2" BorderBrush="#30363D">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="OPERASYON GÜNLÜĞÜ" Foreground="#58A6FF" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ScrollViewer x:Name="scrollLog">
                                <TextBlock x:Name="txtHbysLog" Text="Hazır..." Foreground="#39FF14" FontFamily="Consolas" FontSize="14" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,0,0,15">
                        <Grid Margin="0,0,0,15">
                            <TextBlock x:Name="lblDurum" Text="Hazır" FontSize="16" FontWeight="Bold" Foreground="#455A64" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Background="#F1F3F4" CornerRadius="10" Padding="15" Margin="0,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M11,3L12,3L12,11L11,11L11,3M4,9L4,10L3,10L3,9L4,9M19,9L19,10L18,10L18,9L19,9" Fill="#1A73E8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="lblIPAdresi" Text="Yerel IP: Bekleniyor..." FontSize="14" FontWeight="SemiBold" Foreground="#202124" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <ProgressBar x:Name="progressBar1" Height="18" Foreground="#007ACC" Background="#E0E0E0" BorderThickness="0">
                            <ProgressBar.Clip>
                                <RectangleGeometry Rect="0,0,2000,18" RadiusX="9" RadiusY="9"/>
                            </ProgressBar.Clip>
                        </ProgressBar>

                        <Button x:Name="btnKurulumBaslat" Click="btnKurulumBaslat_Click" Height="65" Margin="0,20,0,0" Style="{StaticResource ModernButtonStyle}" Background="#2E7D32" FontSize="20" FontWeight="Bold">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768; " FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <TextBlock Text="OTOMASYONU BAŞLAT" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <UniformGrid Columns="4" Margin="0,15,0,0">
                            <Button x:Name="btnRaporOlustur" Click="btnRaporOlustur_Click" Height="60" Margin="0,0,5,0" Style="{StaticResource ModernButtonStyle}" Background="#0097A7" FontSize="15">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📥" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Envanter Kaydı" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnAnaListeyiAc" Click="btnAnaListeyiAc_Click" Height="60" Margin="5,0,5,0" Style="{StaticResource ModernButtonStyle}" Background="#607D8B" FontSize="15">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Merkezi Liste" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnDigerModuller" Click="btnDigerModuller_Click" Height="60" Margin="5,0,5,0" Style="{StaticResource ModernButtonStyle}" Background="#E65100" FontSize="15">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛠️" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Ek Modüller" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnUzakKurulum" Click="btnUzakKurulum_Click" Height="60" Margin="5,0,0,0" Style="{StaticResource ModernButtonStyle}" Background="#673AB7" FontSize="15">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📡" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Uzak Kurulum" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Grid>

                <Border x:Name="ChatPanel" Grid.Column="3" Width="0" HorizontalAlignment="Right" Background="#F1F5F9" CornerRadius="25" Margin="25,0,0,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="5" Opacity="0.15" BlurRadius="15"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="80"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="White" CornerRadius="25,25,0,0" BorderThickness="0,0,0,1" BorderBrush="#E2E8F0">
                            <DockPanel VerticalAlignment="Center" Margin="25,0">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <Border Background="#EFF6FF" Width="45" Height="45" CornerRadius="16" Margin="0,0,15,0">
                                        <TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" Foreground="#2563EB" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Sohbet" FontWeight="Bold" FontSize="18" Foreground="#1E293B"/>
                                        <TextBlock Text="Bilgi İşlem Ağı" FontSize="13" Foreground="#64748B"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button x:Name="btnBuzz" Click="btnBuzz_Click" DockPanel.Dock="Right" Style="{StaticResource BuzzButtonStyle}" Width="32" Height="32" ToolTip="Titreşim Gönder"/>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Background="#F8FAFC" Padding="25,15" BorderThickness="0,0,0,1" BorderBrush="#E2E8F0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Kime:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,15,0" FontSize="14"/>
                                <ComboBox x:Name="cmbAlici" Grid.Column="1" SelectedValuePath="Name" SelectedIndex="0" Height="40" VerticalContentAlignment="Center" Background="White" BorderBrush="#CBD5E1" FontSize="14">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="10" Height="10" Margin="0,0,10,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#94A3B8"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                    <Setter Property="Fill" Value="#10B981"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="#334155"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Border Grid.Column="2" Background="#E2E8F0" CornerRadius="10" Padding="12,0" Height="32" Margin="15,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="lblOnlineCount" Text="0" Foreground="#475569" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="2" x:Name="scrollChat" VerticalScrollBarVisibility="Auto" Padding="20">
                            <ItemsControl x:Name="chatMessages" Width="280">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="{Binding Gonderen, Converter={StaticResource AlignmentConverter}}" Margin="0,8">
                                            <Border MaxWidth="250" Padding="15,10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="4" ShadowDepth="2" Direction="270"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Gonderen, Converter={StaticResource AlignmentConverter}}" Value="Right">
                                                                <Setter Property="Background" Value="#2563EB"/>
                                                                <Setter Property="CornerRadius" Value="20,20,0,20"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Gonderen, Converter={StaticResource AlignmentConverter}}" Value="Left">
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="CornerRadius" Value="20,20,20,0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Text="{Binding Gonderen}" FontSize="12" FontWeight="Bold" Margin="0,0,0,3" Opacity="0.9" Foreground="{Binding UserColor}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Gonderen, Converter={StaticResource AlignmentConverter}}" Value="Right">
                                                                        <Setter Property="Foreground" Value="#E0E7FF"/>
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Gonderen, Converter={StaticResource AlignmentConverter}}" Value="Left">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <TextBlock Grid.Row="1" Text="{Binding Icerik}" FontSize="15" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,5">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#334155"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Gonderen, Converter={StaticResource AlignmentConverter}}" Value="Right">
                                                                        <Setter Property="Foreground" Value="White"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <TextBlock Grid.Row="2" Text="{Binding Zaman, StringFormat='HH:mm'}" FontSize="10" HorizontalAlignment="Right" Opacity="0.7">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Gonderen, Converter={StaticResource AlignmentConverter}}" Value="Right">
                                                                        <Setter Property="Foreground" Value="#E0E7FF"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="3" Background="White" CornerRadius="0,0,25,25" Padding="20" BorderThickness="0,1,0,0" BorderBrush="#E2E8F0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="24" Height="48">
                                    <Grid>
                                        <TextBox x:Name="txtMessage" KeyDown="txtMessage_KeyDown" 
                                                 Background="Transparent" BorderThickness="0" 
                                                 VerticalContentAlignment="Center" 
                                                 Padding="20,0,10,0" 
                                                 FontSize="15" 
                                                 Foreground="#334155"
                                                 Tag="Bir mesaj yazın..."/>
                                        <TextBlock Text="Bir mesaj yazın..." VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#94A3B8" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=txtMessage}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <Button Grid.Column="1" Click="btnSendMessage_Click" Style="{StaticResource SendButtonStyle}" Margin="15,0,0,0" ToolTip="Gönder" Width="48" Height="48"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="SettingsPanel" Visibility="Collapsed" Background="#99000000" Panel.ZIndex="2000">
                <Border Background="White" CornerRadius="20" Width="600" Height="600" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="50" ShadowDepth="0" Opacity="0.5"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,25">
                            <TextBlock Text="Sistem Ayarları" FontSize="26" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Button Click="btnSettings_Click" Background="Transparent" Foreground="#EF4444" FontSize="18" BorderThickness="0" Cursor="Hand" Content="❌ KAPAT" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <UniformGrid Columns="2" VerticalAlignment="Top">
                                <StackPanel Margin="0,0,30,0">
                                    <TextBlock Text="Paket Seçimi" FontSize="18" FontWeight="SemiBold" Foreground="#546E7A" Margin="0,0,0,15"/>
                                    <CheckBox x:Name="chkHbysKur" Content="HBYS Otomasyonu (Demo - Yer Tutucu)" IsChecked="True" Margin="0,0,0,15" FontSize="16"/>
                                    <CheckBox x:Name="chkDotNet35" Content=".NET Framework 3.5" IsChecked="True" Margin="0,0,0,15" FontSize="16"/>
                                    <CheckBox x:Name="chkGucAyarlariniYap" Content="Güç Ayarlarını Optimize Et" IsChecked="True" Margin="0,0,0,15" FontSize="16"/>
                                    <CheckBox x:Name="chkDefenderKapat" Content="Defender &amp; Firewall Kapat" IsChecked="True" Margin="0,0,0,15" FontSize="16"/>
                                    <CheckBox x:Name="chkSmartScreenKapat" Content="SmartScreen (Geçmiş Temelli) Kapat" IsChecked="True" Margin="0,0,0,15" FontSize="16"/>
                                    <CheckBox x:Name="chkBGInfoKur" Content="BGInfo Kur" IsChecked="True" Margin="0,0,0,15" FontSize="16"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="Domain İşlemleri" FontSize="18" FontWeight="SemiBold" Foreground="#546E7A" Margin="0,0,0,15"/>
                                    <CheckBox x:Name="chkDomaineKatil" Content="Domaine Dahil Et" IsChecked="False" Margin="0,0,0,20" FontSize="16" FontWeight="Bold" Foreground="#1565C0"/>

                                    <TextBlock Text="Hedef Domain" Margin="0,0,0,5" FontSize="14"/>
                                    <ComboBox x:Name="cmbDomainSecimi" Height="40" Margin="0,0,0,20" FontSize="14">
                                        <ComboBoxItem Content="domain.local" IsSelected="True"/>
                                        <ComboBoxItem Content="domain"/>
                                    </ComboBox>

                                    <TextBlock Text="Yeni PC Adı" Margin="0,0,0,5" FontSize="14"/>
                                    <TextBox x:Name="txtYeniPcAdi" Height="40" FontSize="14"/>
                                </StackPanel>
                            </UniformGrid>
                        </ScrollViewer>

                        <Border Grid.Row="2" Background="#FFFDE7" Padding="20" CornerRadius="10" Margin="0,25,0,0" BorderThickness="1" BorderBrush="#FFF9C4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="⚠️" Margin="0,0,15,0" VerticalAlignment="Top" FontSize="20"/>

                                <TextBlock Grid.Column="1" 
                   Text="Sunucu: 192.168.1.10, 192.168.1.100 ve 192.168.1.150 bağlantıları domain hesabınızla otomatik sağlanacaktır." 
                   FontSize="14" 
                   Foreground="#5D4037" 
                   TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>