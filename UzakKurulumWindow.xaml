                                                            <Button Grid.Column="2" x:Name="btnBrowseBackup" Click="btnBrowseBackup_Click" Content="Gözat..." Height="30" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                                        </Grid>
                                                        <Button x:Name="btnStartBackup" Click="btnStartBackup_Click" Content="📥 YEDEKLEMEYİ BAŞLAT" Height="45" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Sağ Sütun: GERİ YÜKLE -->
                                            <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15">
