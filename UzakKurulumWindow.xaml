                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Text="📤 Profil Geri Yükleme (Restore)" FontSize="14" FontWeight="Bold" Foreground="#16A34A" Margin="0,0,0,10"/>

                                                    <!-- Geri Yüklenecek Kullanıcı -->
                                                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                                                        <TextBlock Text="Hedef Windows Kullanıcı Adı (Format Sonrası Yeni PC)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                                        <TextBox x:Name="txtRestoreUsername" Height="30" VerticalContentAlignment="Center" Padding="5" BorderBrush="#CBD5E1"/>
                                                    </StackPanel>

                                                    <!-- Geri Yüklenecekler Açıklaması -->
                                                    <StackPanel Grid.Row="2">
                                                        <TextBlock Text="Geri Yükleme Bilgisi:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8"/>
                                                        <TextBlock Text="• Yedek klasörünün içindeki yedeklenmiş tüm veriler (Masaüstü, Belgeler vb.) hedef bilgisayarın belirtilen kullanıcı profiline geri kopyalanır." TextWrapping="Wrap" Foreground="#475569" FontSize="11.5" Margin="0,0,0,6"/>
                                                        <TextBlock Text="• 'backup_metadata.json' dosyasında kayıtlı olan ağ yazıcıları ve ağ sürücü harfleri otomatik olarak yeniden bağlanır." TextWrapping="Wrap" Foreground="#475569" FontSize="11.5" Margin="0,0,0,6"/>
                                                        <TextBlock Text="• Tarayıcı şifreleri ve geçmişi sorunsuz aktarılır." TextWrapping="Wrap" Foreground="#475569" FontSize="11.5" Margin="0,0,0,6"/>
                                                        <TextBlock Text="• Outlook imzaları aktif edilir." TextWrapping="Wrap" Foreground="#475569" FontSize="11.5" Margin="0,0,0,6"/>
                                                    </StackPanel>

                                                    <!-- Geri Yükleme Başlat -->
                                                    <StackPanel Grid.Row="3" Margin="0,15,0,0">
                                                        <TextBlock Text="Geri Yüklenecek Yedek Klasör Yolu" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="70"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox x:Name="txtRestorePath" Height="30" VerticalContentAlignment="Center" Padding="5" BorderBrush="#CBD5E1" ToolTip="Yedek klasörünün tam yolunu seçin."/>
                                                            <Button Grid.Column="2" x:Name="btnBrowseRestore" Click="btnBrowseRestore_Click" Content="Seç..." Height="30" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                                        </Grid>
                                                        <Button x:Name="btnStartRestore" Click="btnStartRestore_Click" Content="📤 YEDEKLERİ GERİ YÜKLE" Height="45" Background="#16A34A" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </ScrollViewer>

                                    <!-- Alt Panel: İlerleme & Detay Log -->
                                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,10,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="lblBackupStatus" Text="Durum: Hazır" FontWeight="Bold" Foreground="#334155" FontSize="12"/>
                                                <TextBlock Grid.Column="1" x:Name="lblBackupProgressPct" Text="%0" FontWeight="Bold" Foreground="#2563EB" FontSize="12"/>
                                            </Grid>

                                            <ProgressBar Grid.Row="1" x:Name="barBackupProgress" Height="12" Minimum="0" Maximum="100" Value="0" Background="#E2E8F0" Foreground="#2563EB" Margin="0,0,0,6"/>

                                            <TextBlock Grid.Row="2" x:Name="lblBackupProgressFile" Text="Kopyalanan dosya: -" FontSize="11" Foreground="#64748B" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </TabItem>

                        <TabItem Header="💬 Canlı Sohbet">
                            <Border Background="White" CornerRadius="0,8,8,8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                        <TextBlock Text="Anlık Mesajlaşma (Agentless)" FontWeight="Bold" Foreground="#475569" FontSize="16"/>
                                        <TextBlock Text="Kullanıcı tarafında interaktif bir pencere açılır. Karşılıklı yazışabilirsiniz." FontSize="12" Foreground="Gray" FontStyle="Italic"/>
                                    </StackPanel>

                                    <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Background="#F8FAFC" Margin="0,0,0,10">
                                        <ListBox x:Name="lstChatHistory" BorderThickness="0" Background="Transparent" Padding="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding SenderIcon}" Margin="0,0,10,0" FontSize="16" VerticalAlignment="Top"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{Binding Color}" FontWeight="{Binding Weight}" VerticalAlignment="Center" FontSize="14" LineHeight="20"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Time}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="10,0,0,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="txtChatMessage" Height="50" VerticalContentAlignment="Center" Padding="10,0" 
                                                 BorderBrush="#CBD5E1" FontSize="14" Text="Merhaba, bilgi işlemden yazıyorum..." 
                                                 KeyDown="txtChatMessage_KeyDown"/>

                                        <Button x:Name="btnSendMessage" Grid.Column="1" Click="btnSendMessage_Click" Content="SOHBET ET" Width="110" Margin="10,0,0,0"
                                                Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>

                                        <Button x:Name="btnSendAnnouncement" Grid.Column="2" Click="btnSendAnnouncement_Click" Content="DUYURU GEÇ" Width="110" Margin="10,0,0,0"
                                                Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </TabItem>

                        <TabItem Header="🖨️ Yazıcı &amp; Kalibrasyon">
                            <Border Background="White" CornerRadius="0,8,8,8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- SOL TARAF: Uzak Yazıcı Yönetimi & Takılı Yazıcılar -->
                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="2*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="1.5*"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                            <TextBlock Text="🖨️ Uzak Yazıcı Yönetimi" FontWeight="Bold" Foreground="#1E293B" FontSize="15" Margin="0,0,0,2"/>
                                            <TextBlock Text="Uzak bilgisayarlara yazıcı kurabilir veya takılı yazıcıları sorgulayabilirsiniz." FontSize="11" Foreground="Gray" FontStyle="Italic"/>
                                        </StackPanel>

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                                            <StackPanel>
                                                <!-- A. TCP/IP Yazıcı Kurulumu -->
                                                <TextBlock Text="1. Yeni Ağ Yazıcısı Kur (TCP/IP Port)" FontWeight="Bold" Foreground="#3B82F6" FontSize="12" Margin="0,0,0,5"/>
                                                
                                                <TextBlock Text="Yazıcı Adı" FontSize="10" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                                <TextBox x:Name="txtNewPrinterName" Text="Barkod_Yazici" Height="25" VerticalContentAlignment="Center" Padding="3" Margin="0,0,0,8"/>

                                                <TextBlock Text="Yazıcı IP Adresi" FontSize="10" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                                <TextBox x:Name="txtNewPrinterIP" Text="10.235.80.200" Height="25" VerticalContentAlignment="Center" Padding="3" Margin="0,0,0,8"/>

                                                <TextBlock Text="Sürücü (Driver) Adı" FontSize="10" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                                <ComboBox x:Name="cmbNewPrinterDriver" IsEditable="True" Height="25" SelectedIndex="0" Margin="0,0,0,8" VerticalContentAlignment="Center">
                                                    <ComboBoxItem Content="Generic / Text Only"/>
                                                    <ComboBoxItem Content="ZDesigner GK420t"/>
                                                    <ComboBoxItem Content="ZDesigner S4M-203dpi ZPL"/>
                                                    <ComboBoxItem Content="TSC TTP-244 Pro"/>
                                                    <ComboBoxItem Content="Argox OS-214 plus PPLA"/>
                                                </ComboBox>

                                                <CheckBox x:Name="chkNewPrinterShare" Content="Kurulum Sonrası Paylaşıma Aç" IsChecked="True" FontSize="10" Foreground="#475569" Margin="0,0,0,8"/>
                                                
                                                <Button x:Name="btnInstallPrinter" Click="btnInstallPrinter_Click" Height="32" Margin="0,0,0,10"
                                                        Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <TextBlock Text="➕ IP ÜZERİNDEN KUR" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                                                </Button>

                                                <Separator Height="1" Background="#E2E8F0" Margin="0,2,0,8"/>

                                                <!-- B. Ağdan Paylaşımlı Yazıcı Kur/Bağla -->
                                                <TextBlock Text="2. Paylaşılan Ağ Yazıcısı Ekle (Ağdan Bağla)" FontWeight="Bold" Foreground="#3B82F6" FontSize="12" Margin="0,0,0,5"/>

                                                <TextBlock Text="Ağ Yazıcı Yolu (Shared Path)" FontSize="10" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                                <TextBox x:Name="txtNetworkPrinterPath" Text="\\192.168.1.10\Barkod_Yazici" Height="25" VerticalContentAlignment="Center" Padding="3" Margin="0,0,0,8" ToolTip="Örn: \\sunucu\yazici veya \\IP\paylasimadi"/>

                                                <Button x:Name="btnInstallNetworkPrinter" Click="btnInstallNetworkPrinter_Click" Height="35" Margin="0,0,0,5"
                                                        Background="#8B5CF6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <TextBlock Text="🔗 AĞDAN PAYLAŞIMLI YAZICI BAĞLA" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                                                </Button>
                                            </StackPanel>
                                        </ScrollViewer>

                                        <Separator Grid.Row="2" Height="1" Background="#E2E8F0" Margin="0,2,0,8"/>

                                        <!-- C. Takılı Yazıcılar Listesi -->
                                        <Grid Grid.Row="3">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="🔍 Takılı Yazıcılar (Tek PC)" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" FontSize="12"/>
                                                <Button Grid.Column="1" x:Name="btnGetPrinters" Click="btnGetPrinters_Click" Content="🔄 Listele" Padding="8,3" FontSize="10"
                                                        Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="3"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </Grid>

                                            <DataGrid Grid.Row="1" x:Name="gridPrinters" AutoGenerateColumns="False" CanUserAddRows="False" 
                                                      HeadersVisibility="Column" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" SelectionMode="Single"
                                                      SelectionChanged="gridPrinters_SelectionChanged" FontSize="11">
                                                <DataGrid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="⭐ Varsayılan Yazıcı Yap" Click="MenuSetDefaultPrinter_Click"/>
                                                    </ContextMenu>
                                                </DataGrid.ContextMenu>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Binding="{Binding Name}" Header="Yazıcı Adı" Width="*" IsReadOnly="True" FontWeight="Bold"/>
                                                    <DataGridTextColumn Binding="{Binding Port}" Header="Port" Width="70" IsReadOnly="True"/>
                                                    <DataGridTextColumn Binding="{Binding Driver}" Header="Sürücü" Width="90" IsReadOnly="True"/>
                                                    <DataGridCheckBoxColumn Binding="{Binding Shared}" Header="Payl." Width="35" IsReadOnly="True"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Grid>

                                    <!-- SAĞ TARAF: Barkod Kalibrasyonu -->
                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                                            <TextBlock Text="🏷️ Barkod Yazıcı Kalibrasyonu" FontWeight="Bold" Foreground="#1E293B" FontSize="15" Margin="0,0,0,2"/>
                                            <TextBlock Text="Yazıcıya doğrudan donanımsal kalibrasyon ve test komutları gönderir." FontSize="11" Foreground="Gray" FontStyle="Italic"/>
                                        </StackPanel>

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="Bağlantı Türü" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                                                <StackPanel Orientation="Vertical" Margin="0,0,0,12">
                                                    <RadioButton x:Name="rbCalibNetwork" Content="Ağ Yazıcısı (Direct TCP IP)" IsChecked="True" Checked="CalibMode_Changed" Margin="0,0,0,6" FontWeight="Medium"/>
                                                    <RadioButton x:Name="rbCalibLocal" Content="Uzak PC Yerel/Paylaşılan" Checked="CalibMode_Changed" FontWeight="Medium"/>
                                                </StackPanel>

                                                <TextBlock x:Name="lblCalibTarget" Text="Yazıcı IP Adresi (Port 9100)" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                                                <TextBox x:Name="txtCalibTarget" Text="10.235.80.200" Height="30" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,12"/>

                                                <TextBlock Text="Yazıcı Modeli / Şablon" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                                                <ComboBox x:Name="cmbCalibPreset" Height="30" SelectedIndex="0" Margin="0,0,0,12" SelectionChanged="cmbCalibPreset_SelectionChanged" VerticalContentAlignment="Center">
                                                    <ComboBoxItem Content="Zebra (ZPL) - Kalibrasyon (~JC)"/>
                                                    <ComboBoxItem Content="TSC (TSPL) - Kalibrasyon (GAPDETECT)"/>
                                                    <ComboBoxItem Content="Argox (PPLA) - Kalibrasyon (~S)"/>
                                                    <ComboBoxItem Content="Honeywell (DP) - Kalibrasyon (TESTFEED)"/>
                                                    <ComboBoxItem Content="Özel Komut (Ham Metin)"/>
                                                </ComboBox>

                                                <TextBlock Text="Gönderilecek Ham Komut" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                                                <TextBox x:Name="txtCalibCommand" Text="~JC" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="5" Margin="0,0,0,12" FontFamily="Consolas"/>
                                            </StackPanel>
                                        </ScrollViewer>

                                        <Button Grid.Row="2" x:Name="btnSendCalib" Click="btnSendCalib_Click" Height="45"
                                                Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                            <TextBlock Text="⚡ KALİBRASYON KOMUTU GÖNDER" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </TabItem>
                    </TabControl>

                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="10" Padding="15">
                        <ScrollViewer x:Name="scrollLog">
                            <TextBlock x:Name="txtLog" Text="> Sistem Hazır... Lütfen işlem türünü seçin." 
                                       Foreground="#22C55E" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap"
                                       PreviewMouseLeftButtonDown="TxtLog_PreviewMouseLeftButtonDown" Cursor="Hand" ToolTip="Tüm çıktıyı görmek için çift tıklayın"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>