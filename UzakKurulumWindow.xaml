<Window x:Class="OtoProgram.UzakKurulumWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OtoProgram"
        Title="Toplu Dağıtım Merkezi" Height="820" Width="1350" MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        MouseDown="Window_MouseDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
    </Window.Resources>

    <Border Background="#F3F4F6" CornerRadius="15" BorderThickness="1" BorderBrush="#E5E7EB">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="📡" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="Toplu Dağıtım Merkezi" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="Gelişmiş Tarama &amp; Yönetim Paneli" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <ToggleButton x:Name="btnModDegistir" Click="btnModDegistir_Click" Width="160" Height="35" Margin="0,0,10,0"
                                  Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="brd" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock x:Name="txtModIcon" Text="📥" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14"/>
                                        <TextBlock x:Name="txtModYazi" Text="Mod: KURULUM" FontWeight="Bold" VerticalAlignment="Center" Foreground="#0F172A"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="brd" Property="Background" Value="#FEF2F2"/>
                                        <Setter TargetName="brd" Property="BorderBrush" Value="#EF4444"/>
                                        <Setter TargetName="txtModYazi" Property="Foreground" Value="#DC2626"/>
                                        <Setter TargetName="txtModYazi" Property="Text" Value="Mod: KALDIRMA"/>
                                        <Setter TargetName="txtModIcon" Property="Text" Value="🗑️"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Button Content="✕" Click="BtnKapat_Click" 
                            Background="#EF4444" Foreground="White" Width="35" Height="35" 
                            FontSize="16" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" MinWidth="300"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="15">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="3" Opacity="0.1" BlurRadius="10"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Tek IP, IP aralığı veya bilgisayar adı girin (virgülle ayırarak çoklu yazabilirsiniz)." 
                                   FontSize="11" Foreground="#64748B" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <Grid Grid.Row="1" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtSmartSearch" Text="10.235.80.1-100" VerticalContentAlignment="Center" Padding="8,5" Height="35"
                                     FontSize="12" BorderBrush="#CBD5E1" ToolTip="Örn: 10.235.80.5 veya 10.235.80.1-50 veya 10.235.80.*, 10.235.90.1-20 veya BILGIISLEM-PC"/>
                            <Button Grid.Column="1" x:Name="btnSmartTara" Click="btnSmartTara_Click" Content="🔍 Tara / Bul" Margin="8,0,0,0" Width="100" Height="35"
                                    Background="#3B82F6" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnTemizle" Click="btnTemizle_Click" Content="🗑️ Temizle" 
                                    FontSize="12" Padding="10,4" HorizontalAlignment="Left"
                                    Background="#FFF1F2" Foreground="#E11D48" BorderBrush="#FECDD3" BorderThickness="1">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="btnTumuSec" Content="Tümünü Seç" Click="btnTumuSec_Click" 
                                        FontSize="12" Padding="10,4" Margin="0,0,5,0" Width="100"
                                        Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                <Button Content="Ters Çevir" Click="btnTersCevir_Click" 
                                        FontSize="12" Padding="10,4" 
                                        Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="3" x:Name="gridPcs" AutoGenerateColumns="False" CanUserAddRows="False" 
                                  HeadersVisibility="Column" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="🔄 Yeniden Başlat" Click="MenuRestart_Click"/>
                                    <MenuItem Header="🛑 Kapat" Click="MenuShutdown_Click"/>
                                    <Separator/>
                                    <MenuItem Header="🖨️ Yazıcı Servisini Resetle" Click="MenuSpooler_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Header="Seç" Width="40"/>
                                <DataGridTextColumn Binding="{Binding IP}" Header="IP Adresi" Width="110" IsReadOnly="True" FontWeight="Medium"/>
                                <DataGridTextColumn Binding="{Binding Hostname}" Header="Bilgisayar Adı" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Binding="{Binding Durum}" Header="Durum" Width="70" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Durum}" Value="Açık">
                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Toplu Rapor Butonu -->
                        <Button Grid.Row="4" x:Name="btnRaporla" Click="BtnRaporla_Click" Height="40" Margin="0,8,0,0"
                                Background="#8B5CF6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📊" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="SEÇİLİ PC'LERİ RAPORLA (CSV)" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="160"/>
                    </Grid.RowDefinitions>

                    <TabControl Grid.Row="0" Margin="0,0,0,15" BorderThickness="0" Background="Transparent">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="15,10"/>
                                <Setter Property="Margin" Value="0,0,5,0"/>
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="8,8,0,0" Margin="0,0,2,0" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#3B82F6"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="False">
                                                    <Setter TargetName="Border" Property="Background" Value="#E2E8F0"/>
                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                        <TabItem Header="📦 Yazılım Dağıtım">
                            <Border Background="White" CornerRadius="0,8,8,8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Yüklenecek/Kaldırılacak Paketler" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,10"/>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="itemsKategoriler">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Expander IsExpanded="True" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1" Background="#F8F9FB">
                                                        <Expander.Header>
                                                            <StackPanel Orientation="Horizontal" Height="30">
                                                                <TextBlock Text="📁" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                                <TextBlock Text="{Binding CategoryName}" FontWeight="SemiBold" FontSize="14" Foreground="#334155" VerticalAlignment="Center"/>
                                                                <TextBlock Text="(Tıkla Aç/Kapa)" FontSize="10" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0" FontStyle="Italic"/>
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <StackPanel Background="White" Margin="10,5,0,5">
                                                            <CheckBox IsChecked="{Binding IsSelected}" Content="Tüm Kategoriyi Seç" Margin="5,5,0,5" FontWeight="Bold" Foreground="#64748B"/>
                                                            <ItemsControl ItemsSource="{Binding Apps}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="White" CornerRadius="5" Margin="20,2,5,2" Padding="8" BorderThickness="0,0,0,1" BorderBrush="#F1F5F9">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                                                <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="13" Foreground="#475569"/>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Expander>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <Button Grid.Row="2" x:Name="btnBaslat" Click="btnBaslat_Click" Content="🚀 İŞLEMİ BAŞLAT" Height="50" Margin="0,15,0,0"
                                            Background="#10B981" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="brd" Background="{TemplateBinding Background}" CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="brd" Property="Opacity" Value="0.9"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="brd" Property="Background" Value="#94A3B8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </TabItem>

                        <TabItem Header="🛠️ Sistem &amp; Güvenlik">
                            <Border Background="White" CornerRadius="0,8,8,8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Sol Kolon: Firewall -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="🛡️ Güvenlik Duvarı (Firewall)" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="btnFirewallOff" Click="btnFirewallOff_Click" Content="KAPAT (Turn Off)" Margin="0,0,5,0" Height="40" Background="#FEF2F2" BorderBrush="#FECDD3" BorderThickness="1" Foreground="#DC2626">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="5"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                                <Button x:Name="btnFirewallOn" Click="btnFirewallOn_Click" Grid.Column="1" Content="AÇ (Turn On)" Margin="5,0,0,0" Height="40" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" Foreground="#059669">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="5"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Sağ Kolon: Telemetry -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="📊 Windows İzleme (Telemetry)" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,8"/>
                                            <Button x:Name="btnDisableTelemetry" Click="btnDisableTelemetry_Click" Content="🚫 TELEMETRİ &amp; İZLEMEYİ KAPAT" Height="40" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" Foreground="#D97706" FontWeight="SemiBold">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="5"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="👤 Bilgisayardaki Kullanıcılar" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                                        <Button x:Name="btnKullanicilariGetir" Click="btnKullanicilariGetir_Click" Content="🔍 Listeyi Getir" Margin="15,0,0,0" Padding="10,4" FontSize="11" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                        <TextBlock Text="(Soldan bir PC seçiniz)" FontSize="10" FontStyle="Italic" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>

                                    <DataGrid Grid.Row="2" x:Name="gridRemoteUsers" AutoGenerateColumns="False" CanUserAddRows="False" 
                                              HeadersVisibility="Column" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Binding="{Binding Username}" Header="Kullanıcı Adı" Width="*" IsReadOnly="True" FontWeight="Medium"/>
                                            <DataGridTextColumn Binding="{Binding Status}" Header="Durum" Width="100" IsReadOnly="True"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Grid Grid.Row="3" Margin="0,15,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="btnMakeAdmin" Click="btnMakeAdmin_Click" Content="👑 Local Admin YAP" Margin="0,0,5,0" Height="45" Background="#DBEAFE" Foreground="#1E40AF" FontWeight="Bold" BorderThickness="0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        <Button x:Name="btnRemoveAdmin" Click="btnRemoveAdmin_Click" Grid.Column="1" Content="❌ Yetkiyi AL" Margin="5,0,0,0" Height="45" Background="#F1F5F9" Foreground="#64748B" BorderThickness="0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </TabItem>

                        <TabItem Header="👤 AD &amp; Şifre">
                            <Border Background="White" CornerRadius="0,8,8,8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="380" />
                                    </Grid.ColumnDefinitions>

                                    <!-- SOL TARAF: Arama ve Liste -->
                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Margin="0,0,0,10" Padding="10" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBox x:Name="txtADSearch" Height="35" VerticalContentAlignment="Center" Padding="5" 
                                                         FontSize="14" BorderBrush="#CBD5E1" 
                                                         Tag="Ad Soyad veya Kullanıcı Adı..." Text="Ad Soyad veya Kullanıcı Adı..." 
                                                         Foreground="Gray" GotFocus="TxtADSearch_GotFocus" LostFocus="TxtADSearch_LostFocus"
                                                         KeyDown="txtADSearch_KeyDown"/>

                                                <Button x:Name="btnADSearch" Grid.Column="1" Click="btnADSearch_Click" Content="🔍 ARA" Width="80" Margin="10,0,0,0"
                                                        Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="5"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <DataGrid Grid.Row="1" x:Name="gridAdUsers" AutoGenerateColumns="False" CanUserAddRows="False" 
                                                  Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" SelectionMode="Single"
                                                  SelectionChanged="gridAdUsers_SelectionChanged">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Binding="{Binding DisplayName}" Header="Ad Soyad" Width="*" IsReadOnly="True" FontWeight="Bold"/>
                                                <DataGridTextColumn Binding="{Binding SamAccountName}" Header="Kullanıcı Adı" Width="110" IsReadOnly="True"/>
                                                <DataGridTextColumn Binding="{Binding Durum}" Header="Durum" Width="70" IsReadOnly="True">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Durum}" Value="KİLİTLİ">
                                                                    <Setter Property="Foreground" Value="Red"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Durum}" Value="Aktif">
                                                                    <Setter Property="Foreground" Value="Green"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Durum}" Value="Pasif">
                                                                    <Setter Property="Foreground" Value="Gray"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>

                                    <!-- SAĞ TARAF: Kullanıcı Detay Kartı ve İşlemleri -->
                                    <Border Grid.Column="2" Background="#F8FAFC" CornerRadius="8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <Grid>
                                            <!-- Seçim Yoksa Gösterilecek Uyarı -->
                                            <TextBlock x:Name="lblNoUserSelected" Text="Detayları görüntülemek ve işlem yapmak için lütfen soldaki listeden bir kullanıcı seçiniz." 
                                                       Foreground="Gray" FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>

                                            <!-- Yükleniyor Göstergesi -->
                                            <TextBlock x:Name="lblLoadingDetails" Text="Detaylar yükleniyor..." Visibility="Collapsed"
                                                       Foreground="#3B82F6" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            <!-- Detay ve İşlem Paneli -->
                                            <Grid x:Name="pnlUserDetails" Visibility="Collapsed">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/> <!-- Başlık / İsim -->
                                                    <RowDefinition Height="*"/>    <!-- Bilgiler (Scrollable) -->
                                                    <RowDefinition Height="Auto"/> <!-- Aksiyonlar -->
                                                </Grid.RowDefinitions>

                                                <!-- Kullanıcı Başlığı -->
                                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                                    <TextBlock x:Name="lblAdDisplayName" Text="-" FontSize="16" FontWeight="Bold" Foreground="#1E293B" TextWrapping="Wrap"/>
                                                    <TextBlock x:Name="lblAdUsername" Text="@username" FontSize="12" Foreground="Gray" Margin="0,2,0,5"/>
                                                    <Separator Background="#E2E8F0"/>
                                                </StackPanel>

                                                <!-- Bilgi Listesi -->
                                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Hesap Durumu:" Foreground="#64748B" FontSize="11"/>
                                                            <TextBlock x:Name="lblAdStatus" Grid.Column="1" Text="-" FontWeight="Bold" FontSize="12"/>
                                                        </Grid>

                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Departman / Birim:" Foreground="#64748B" FontSize="11"/>
