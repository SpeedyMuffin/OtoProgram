                                                                <TextBlock Text="Daha detaylı takip ve gerçek zamanlı çıktı akışı için giriş alanına çift tıklayarak Detaylı Terminal penceresini açabilirsiniz." FontSize="10" Foreground="Gray" Margin="0,5,0,0" HorizontalAlignment="Center" TextAlignment="Center" Width="400" TextWrapping="Wrap"/>
