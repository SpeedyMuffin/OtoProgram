                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Oluşturulma Tarihi:" Foreground="#64748B" FontSize="11"/>
                                                            <TextBlock x:Name="lblAdCreated" Grid.Column="1" Text="-" FontSize="12" Foreground="#1E293B"/>
                                                        </Grid>

                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Son Giriş Zamanı:" Foreground="#64748B" FontSize="11"/>
                                                            <TextBlock x:Name="lblAdLastLogon" Grid.Column="1" Text="-" FontSize="12" Foreground="#1E293B"/>
                                                        </Grid>

                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Şifre Son Değişim:" Foreground="#64748B" FontSize="11"/>
                                                            <TextBlock x:Name="lblAdPassLastSet" Grid.Column="1" Text="-" FontSize="12" Foreground="#1E293B"/>
                                                        </Grid>

                                                        <Separator Margin="0,10" Background="#E2E8F0"/>

                                                        <!-- Politika Kutuları -->
                                                        <CheckBox x:Name="chkNeverExpires" Content="Şifre Süresi Hiç Dolmasın" Click="chkNeverExpires_Click" Margin="0,2,0,5" Foreground="#475569" FontSize="11" FontWeight="Medium"/>
                                                        <CheckBox x:Name="chkZorunlu" Content="İlk girişte şifre değiştirsin" IsChecked="False" Margin="0,2,0,5" Foreground="#475569" FontSize="11"/>
                                                    </StackPanel>
                                                </ScrollViewer>

                                                <!-- Aksiyon Butonları -->
                                                <Border Grid.Row="2" Background="#F1F5F9" Margin="0,5,0,0" Padding="8" CornerRadius="8">
                                                    <StackPanel>
                                                        <TextBlock Text="Hesap İşlemleri" FontWeight="Bold" Foreground="#475569" FontSize="11" Margin="0,0,0,8"/>
                                                        
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="5"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="5"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <Button x:Name="btnEnableAccount" Click="btnEnableAccount_Click" Content="✅ Aktif Et" Grid.Column="0" Height="28" FontSize="11" Background="#ECFDF5" Foreground="#059669" BorderBrush="#A7F3D0" BorderThickness="1" FontWeight="SemiBold">
                                                                <Button.Resources>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="CornerRadius" Value="4"/>
                                                                    </Style>
                                                                </Button.Resources>
                                                            </Button>

                                                            <Button x:Name="btnDisableAccount" Click="btnDisableAccount_Click" Content="❌ Kapat" Grid.Column="2" Height="28" FontSize="11" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECDD3" BorderThickness="1" FontWeight="SemiBold">
                                                                <Button.Resources>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="CornerRadius" Value="4"/>
                                                                    </Style>
                                                                </Button.Resources>
                                                            </Button>

                                                            <Button x:Name="btnADUnlock" Click="btnADUnlock_Click" Content="🔓 Kilit Aç" Grid.Column="4" Height="28" FontSize="11" Background="#EFF6FF" Foreground="#2563EB" BorderBrush="#BFDBFE" BorderThickness="1" FontWeight="SemiBold">
                                                                <Button.Resources>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="CornerRadius" Value="4"/>
                                                                    </Style>
                                                                </Button.Resources>
                                                            </Button>
                                                        </Grid>

                                                        <Button x:Name="btnResetStandard" Click="btnResetStandard_Click" Height="32" Margin="0,0,0,8" 
                                                                Background="#4F46E5" Foreground="White" BorderThickness="0" FontWeight="Bold" Content="⚡ Standart Şifre Ata">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="5"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox x:Name="txtNewPass" Height="30" VerticalContentAlignment="Center" Padding="5" Text="YeniSifre123." BorderBrush="#CBD5E1"/>
                                                            <Button x:Name="btnResetCustom" Click="btnResetCustom_Click" Grid.Column="1" Content="Özel Şifre" Width="80" Margin="5,0,0,0" Background="#F59E0B" Foreground="White" FontWeight="Bold">
                                                                <Button.Resources>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="CornerRadius" Value="4"/>
                                                                    </Style>
                                                                </Button.Resources>
                                                            </Button>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </TabItem>

                        <TabItem Header="🖥️ Uzak Analiz &amp; Süreçler">
                            <Border Background="White" CornerRadius="0,8,8,8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300" MinWidth="260"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- SOL PANEL: Donanım Bilgisi -->
                                    <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                                                <TextBlock Text="🖥️ Uzak Donanım Bilgisi" FontWeight="Bold" Foreground="#1E293B" FontSize="15" Margin="0,0,0,5"/>
                                                <TextBlock Text="Seçili PC'nin sistem bileşenleri sorgulanır." FontSize="11" Foreground="Gray" FontStyle="Italic"/>
                                            </StackPanel>

                                            <Button Grid.Row="1" x:Name="btnGetSystemInfo" Click="btnGetSystemInfo_Click" Content="🔍 Sistem Bilgisi Sorgula" Height="35"
                                                    Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,0,15">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>

                                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel Margin="0,0,8,0">
                                                    <TextBlock Text="İşletim Sistemi" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="lblSysOS" Text="-" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                                    <TextBlock Text="İşlemci (CPU)" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="lblSysCPU" Text="-" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                                    <TextBlock Text="Toplam Bellek (RAM)" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="lblSysRAM" Text="-" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B" Margin="0,0,0,8"/>

                                                    <TextBlock Text="Çalışma Süresi (Uptime)" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="lblSysUptime" Text="-" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="lblSysLastBoot" Text="-" FontSize="10" FontStyle="Italic" Foreground="Gray" Margin="0,0,0,8"/>

                                                    <TextBlock Text="Disk Durumu (C:)" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="lblSysDisk" Text="-" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B" Margin="0,0,0,4"/>
                                                    <ProgressBar x:Name="barSysDisk" Height="8" Minimum="0" Maximum="100" Value="0" Background="#E2E8F0" Foreground="#3B82F6" Margin="0,0,0,4">
                                                        <ProgressBar.Template>
                                                            <ControlTemplate TargetType="ProgressBar">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                    <Grid>
                                                                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/>
                                                                    </Grid>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </ProgressBar.Template>
                                                    </ProgressBar>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="lblSysDiskPct" Text="Doluluk: %0" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" x:Name="btnDiskCleanup" Click="btnDiskCleanup_Click" Content="🧹 Temizle" Padding="8,3" FontSize="10"
                                                                Background="#FFF1F2" Foreground="#E11D48" BorderBrush="#FECDD3" BorderThickness="1" Cursor="Hand">
                                                            <Button.Resources>
                                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style>
                                                            </Button.Resources>
                                                        </Button>
                                                    </Grid>
                                                    <TextBlock Text="Fiziksel Disk &amp; S.M.A.R.T" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="lblSysDiskHealth" Text="-" FontWeight="SemiBold" FontSize="11" Foreground="#1E293B" Margin="0,0,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>

                                    <!-- SAĞ PANEL: TabControl ile Tüm Analizler -->
                                    <Grid Grid.Column="2">
                                        <TabControl BorderThickness="0" Background="Transparent">
                                            <TabControl.Resources>
                                                <Style TargetType="TabItem">
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Padding" Value="12,8"/>
                                                    <Setter Property="Margin" Value="0,0,3,0"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="TabItem">
                                                                <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="8,8,0,0" Margin="0,0,2,0" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Border" Property="Background" Value="#10B981"/>
                                                                        <Setter Property="Foreground" Value="White"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="False">
                                                                        <Setter TargetName="Border" Property="Background" Value="#E2E8F0"/>
                                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </TabControl.Resources>

                                            <!-- Tab 1: Süreç Yöneticisi -->
                                            <TabItem Header="🚫 Süreç Yöneticisi">
                                                <Border Background="White" CornerRadius="0,8,8,8" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="🚫 Uzak Görev Yöneticisi" FontWeight="Bold" Foreground="#1E293B" FontSize="14"/>
                                                                <TextBlock Text="Uzak bilgisayardaki çalışan süreçleri listeler." FontSize="11" Foreground="Gray" FontStyle="Italic" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" x:Name="btnGetProcesses" Click="btnGetProcesses_Click" Content="🔄 Süreçleri Getir" Width="140" Height="35" VerticalAlignment="Center" Margin="10,0,0,0"
                                                                    Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                                                <Button.Resources>
                                                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                                                                </Button.Resources>
                                                            </Button>
                                                        </Grid>
                                                        <DataGrid Grid.Row="1" x:Name="gridProcesses" AutoGenerateColumns="False" CanUserAddRows="False" 
                                                                  HeadersVisibility="Column" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Binding="{Binding Name}" Header="Süreç Adı" Width="*" IsReadOnly="True" FontWeight="Bold"/>
                                                                <DataGridTextColumn Binding="{Binding Id}" Header="PID" Width="80" IsReadOnly="True"/>
                                                                <DataGridTextColumn Binding="{Binding MemoryUsage}" Header="Bellek" Width="100" IsReadOnly="True"/>
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        <!-- Hızlı Görev Sonlandırma Alanı (Grid.Row=2) -->
                                                        <Border Grid.Row="2" Margin="0,8,0,0" Padding="10" Background="#FEF2F2" CornerRadius="8" BorderBrush="#FEE2E2" BorderThickness="1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="10"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="10"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="Hızlı Sonlandır:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#991B1B"/>
                                                                <TextBox Grid.Column="2" x:Name="txtKillProcessName" Height="30" VerticalContentAlignment="Center" Padding="5" 
                                                                         BorderBrush="#FCA5A5" BorderThickness="1" Tag="Süreç adını girin (Örn: chrome.exe veya hbys.exe)..." 
                                                                         Text="Süreç adını girin (Örn: chrome.exe veya hbys.exe)..." Foreground="Gray" GotFocus="TxtKillProcessName_GotFocus" LostFocus="TxtKillProcessName_LostFocus"/>
                                                                 
                                                                <Button Grid.Column="4" x:Name="btnKillProcess" Click="btnKillProcess_Click" Content="🛑 SÜRECİ SONLANDIR" Padding="15,0" Height="30"
                                                                        Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                                                    <Button.Resources>
                                                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                                                    </Button.Resources>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </TabItem>

                                            <!-- Tab 2: Aktif Oturumlar -->
                                            <TabItem Header="👥 Aktif Oturumlar">
                                                <Border Background="White" CornerRadius="0,8,8,8" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="👥 Aktif Oturum Yöneticisi" FontWeight="Bold" Foreground="#1E293B" FontSize="14"/>
                                                                <TextBlock Text="Seçili bilgisayardaki aktif ve pasif oturumları listeler ve yönetir." FontSize="11" Foreground="Gray" FontStyle="Italic"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                <Button x:Name="btnGetActiveSessions" Click="btnGetActiveSessions_Click" Content="🔄 Oturumları Getir" Width="150" Height="35"
                                                                        Background="#0D9488" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                                                    <Button.Resources>
                                                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                                                                    </Button.Resources>
                                                                </Button>
                                                                <Button x:Name="btnShadowSession" Click="btnShadowSession_Click" Content="🖥️ Ekran İzle (Shadow)" Width="170" Height="35" Margin="8,0,0,0"
                                                                        Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                                                    <Button.Resources>
                                                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                                                                    </Button.Resources>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                        
                                                        <DataGrid Grid.Row="1" x:Name="gridActiveSessions" AutoGenerateColumns="False" CanUserAddRows="False" 
                                                                  HeadersVisibility="Column" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" FontSize="11">
                                                            <DataGrid.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="🖥️ Oturuma Bağlan (RDP Shadow)" Click="MenuShadowSession_Click"/>
                                                                    <MenuItem Header="❌ Oturumu Sonlandır (Logoff)" Click="MenuLogoffSession_Click"/>
                                                                </ContextMenu>
                                                            </DataGrid.ContextMenu>
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Binding="{Binding Username}" Header="Kullanıcı" Width="*" IsReadOnly="True" FontWeight="Bold"/>
                                                                <DataGridTextColumn Binding="{Binding SessionName}" Header="Oturum" Width="100" IsReadOnly="True"/>
                                                                <DataGridTextColumn Binding="{Binding SessionId}" Header="ID" Width="50" IsReadOnly="True"/>
                                                                <DataGridTextColumn Binding="{Binding State}" Header="Durum" Width="100" IsReadOnly="True"/>
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </Grid>
                                                </Border>
                                            </TabItem>

                                            <!-- Tab 3: Paylaşılan Klasörler -->
                                            <TabItem Header="📂 Paylaşılan Klasörler">
