                        <TabItem Header="💾 Profil Yedekleme">
                            <Border Background="White" CornerRadius="0,8,8,8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Üst Bilgi -->
                                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                                        <TextBlock Text="💾 Kullanıcı Profil Yedekleme ve Geri Yükleme" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                                        <TextBlock Text="Masaüstü, Belgeler, İndirilenler, Tarayıcı verileri, Outlook imzaları, Ağ sürücüleri ve yazıcılarını yedekler veya geri yükler." FontSize="11" Foreground="Gray" FontStyle="Italic"/>
                                    </StackPanel>

                                    <!-- Orta Panel: İki Sütun (Yedekle / Geri Yükle) -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Sol Sütun: YEDEKLE -->
                                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Text="📥 Profil Yedekleme (Backup)" FontSize="14" FontWeight="Bold" Foreground="#2563EB" Margin="0,0,0,10"/>

                                                    <!-- Kullanıcı Sorgulama -->
                                                    <Grid Grid.Row="1" Margin="0,0,0,15">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="130"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Uzak/Yerel Kullanıcı Adı" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                                            <TextBox x:Name="txtBackupUsername" Height="30" VerticalContentAlignment="Center" Padding="5" BorderBrush="#CBD5E1"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="2" x:Name="btnQueryActiveUser" Click="btnQueryActiveUser_Click" Content="👤 Kullanıcıyı Bul" VerticalAlignment="Bottom" Height="30" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                        </Button>
                                                    </Grid>

                                                    <!-- Yedeklenecekler Listesi -->
                                                    <StackPanel Grid.Row="2">
                                                        <TextBlock Text="Yedeklenecek Öğeleri Seçin:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8"/>
                                                        <CheckBox x:Name="chkBackupDesktop" Content="Masaüstü Dosyaları (Desktop)" IsChecked="True" Margin="0,0,0,6" Foreground="#334155"/>
                                                        <CheckBox x:Name="chkBackupDocuments" Content="Belgelerim Klasörü (Documents)" IsChecked="True" Margin="0,0,0,6" Foreground="#334155"/>
                                                        <CheckBox x:Name="chkBackupDownloads" Content="İndirilenler (Downloads) [Büyük boyutlu olabilir]" IsChecked="False" Margin="0,0,0,6" Foreground="#334155"/>
                                                        <CheckBox x:Name="chkBackupChrome" Content="Google Chrome Şifre ve Profil Ayarları" IsChecked="True" Margin="0,0,0,6" Foreground="#334155"/>
                                                        <CheckBox x:Name="chkBackupEdge" Content="Microsoft Edge Şifre ve Profil Ayarları" IsChecked="True" Margin="0,0,0,6" Foreground="#334155"/>
                                                        <CheckBox x:Name="chkBackupOutlookSignatures" Content="Outlook E-Posta İmzaları (Signatures)" IsChecked="True" Margin="0,0,0,6" Foreground="#334155"/>
                                                        <CheckBox x:Name="chkBackupNetPrinters" Content="Tanımlı Ağ Yazıcıları &amp; Sürücü Harfleri" IsChecked="True" Margin="0,0,0,6" Foreground="#334155"/>
                                                        <CheckBox x:Name="chkBackupOracleTns" Content="Oracle TNS Yapılandırması (tnsnames.ora)" IsChecked="True" Margin="0,0,0,6" Foreground="#334155"/>
                                                    </StackPanel>

                                                    <!-- Yedekleme Başlat -->
                                                    <StackPanel Grid.Row="3" Margin="0,15,0,0">
                                                        <TextBlock Text="Yedekleme Kayıt Hedefi (Sunucu, Flash Disk, PC vb.)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
