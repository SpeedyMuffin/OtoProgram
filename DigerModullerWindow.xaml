<Window x:Class="OtoProgram.DigerModullerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teknik Araçlar ve Ek Modüller Dashboard" Height="740" Width="1200"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9" FontFamily="Segoe UI"
        WindowStyle="None" AllowsTransparency="True" MouseDown="Window_MouseDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="#F1F5F9" CornerRadius="12" BorderThickness="1.5" BorderBrush="#CBD5E1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" Opacity="0.1" BlurRadius="12"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Başlık Alanı -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="⚡ Teknik Araçlar ve Ek Modüller Dashboard" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="HBYS modül yönetimi, network testleri, veritabanı onarım ve Windows güncelleme merkezi" FontSize="12" Foreground="#64748B"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Click="BtnKapat_Click" Width="35" Height="35"
                        Background="#EF4444" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" FontSize="14">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- İçerik Alanı -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- SOL PANEL: HBYS, Oracle, Barkod ve Hızlı Bakım -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,10,0">
                        
                        <!-- Kart 1: HBYS & Envanter Yönetimi -->
                        <Border Background="White" CornerRadius="8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="🏥 HBYS &amp; Envanter Araçları" FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="HBYS MODÜLLERİ (Demo)" Click="btnHbysModuller_Click" Height="45"
                                            Background="#4F46E5" Foreground="White" FontWeight="Bold" FontSize="11" Cursor="Hand" BorderThickness="0">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Grid.Column="2" Content="ENVANTER LİSTESİ (CSV)" Click="btnListeyiAc_Click" Height="45"
                                            Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="11" Cursor="Hand" BorderThickness="0">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Kart 2: Oracle & HBYS Onarım -->
                        <Border Background="White" CornerRadius="8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="⚙️ Oracle &amp; Veritabanı Onarım" FontSize="14" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,5"/>
                                <TextBlock Text="Lokal C:\orant dizini eksikse ağdan çeker ve sistem PATH değişkenini onarır." FontSize="11" Foreground="#64748B" FontStyle="Italic" Margin="0,0,0,10"/>
                                <Button x:Name="btnFixOrant" Click="btnFixOrant_Click" Height="45" Background="#1E3A8A" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🛠️ " FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="ORANT / BIN HATASINI GİDER" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Kart 3: Barkod Otomasyonu -->
                        <Border Background="White" CornerRadius="8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="🏷️ Barkod Yazıcı Otomasyonu" FontSize="14" FontWeight="Bold" Foreground="#EA580C" Margin="0,0,0,5"/>
                                <TextBlock Text="Barkod yazıcıyı paylaşıma açar ve LPT1 portuna yönlendirerek onarır." FontSize="11" Foreground="#64748B" FontStyle="Italic" Margin="0,0,0,10"/>
                                <Button x:Name="btnAutoBarcodeFix" Click="btnAutoBarcodeFix_Click" Height="45" Background="#EA580C" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🏷️ " FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="TEK TIKLA LPT1 BARKODU ONAR" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Kart 4: Network & Sistem Bakım -->
                        <Border Background="White" CornerRadius="8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="🔧 Network ve Hızlı Sistem Bakım" FontSize="14" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,10"/>
                                
                                <!-- Ping Testi -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtPingIp" Text="192.168.1.10" VerticalContentAlignment="Center" FontSize="12.5" Padding="5" BorderBrush="#CBD5E1"/>
                                    <Button Grid.Column="2" Content="PİNG TESTİ" Click="btnPing_Click" Height="32" Background="#475569" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>

                                <!-- Hızlı Bakım Butonları -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="🧹 TEMP TEMİZLE" Click="btnTempSil_Click" Height="38" Background="#64748B" Foreground="White" FontWeight="Bold" FontSize="11" Cursor="Hand" BorderThickness="0">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Grid.Column="2" Content="🔄 EXPLORER YENİLE" Click="btnRestartExplorer_Click" Height="38" Background="#EF4444" Foreground="White" FontWeight="Bold" FontSize="11" Cursor="Hand" BorderThickness="0">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- SAĞ PANEL: Windows Update Yönetimi -->
                <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <TextBlock Grid.Row="0" Text="🔄 Windows Update Yönetim Merkezi" FontSize="14" FontWeight="Bold" Foreground="#0F766E" Margin="0,0,0,8"/>
                        
                        <!-- Servis Kontrol Butonları -->
                        <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,10">
                            <Button Content="🛑 UPDATE DURDUR (KİLİTLE)" Tag="stop" Click="btnUpdateServisKontrol_Click" Margin="2" Height="35"
                                    Background="#DC2626" Foreground="White" FontWeight="Bold" FontSize="11" Cursor="Hand" BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="▶ UPDATE BAŞLAT (AKTİF)" Tag="start" Click="btnUpdateServisKontrol_Click" Margin="2" Height="35"
                                    Background="#16A34A" Foreground="White" FontWeight="Bold" FontSize="11" Cursor="Hand" BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                                </Button.Resources>
                            </Button>
                        </UniformGrid>

                        <!-- Seçenekler -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,10">
                            <CheckBox x:Name="chkIstegeBagli" Content="İsteğe Bağlıları Dahil Et (.NET, Sürücüler vb.)" Margin="5,3" Foreground="#475569" FontSize="12" FontWeight="Medium"/>
                            <CheckBox x:Name="chkDirectUpdate" Content="WSUS Baypas Et (Doğrudan Microsoft Update'ten Ara)" Margin="5,3,5,10" Foreground="#1E3A8A" FontSize="12" FontWeight="Bold"/>
                            
                            <Button x:Name="btnUpdateKontrol" Click="btnUpdateKontrol_Click" Height="42" Background="#0F766E" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔍 " FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="GÜNCELLEMELERİ TARA VE BOYUT HESAPLA" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <!-- Güncelleme Listesi -->
                        <Border Grid.Row="3" BorderThickness="1" BorderBrush="#E2E8F0" CornerRadius="6" Margin="0,5">
                            <ListBox x:Name="lstUpdates" BorderThickness="0" Background="White" HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}" Margin="2" VerticalContentAlignment="Center">
                                            <Grid Width="500">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Title}" TextWrapping="Wrap" FontSize="11.5" Foreground="#334155" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" FontWeight="Bold" Foreground="#2563EB" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Toplu Seçim Butonları -->
                        <UniformGrid Grid.Row="4" Columns="2" Margin="0,5">
                            <Button Content="✅ Hepsini Seç" Click="btnSelectAll_Click" Margin="2" Height="30" Background="#F1F5F9" Foreground="#334155" FontWeight="Medium" BorderBrush="#CBD5E1" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="❌ Seçimi Kaldır" Click="btnDeselectAll_Click" Margin="2" Height="30" Background="#F1F5F9" Foreground="#334155" FontWeight="Medium" BorderBrush="#CBD5E1" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                </Button.Resources>
                            </Button>
                        </UniformGrid>

                        <!-- İndir Butonu -->
                        <Button Grid.Row="5" x:Name="btnDownloadSelected" Click="btnDownloadSelected_Click" Height="45" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="13" Cursor="Hand" BorderThickness="0" Margin="0,5,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📥 " FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="SEÇİLEN GÜNCELLEMELERİ İNDİR VE YÜKLE" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>