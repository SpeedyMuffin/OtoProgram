<Window x:Class="OtoProgram.RecentActionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Son İşlemler &amp; Hızlı Erişim" Height="520" Width="400"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        MouseDown="Window_MouseDown">
    <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1.5">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="📌" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock Text="Hızlı Erişim &amp; Son İşlemler" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="Son yapılan 10 işlem ve hızlı erişim kısayolları" FontSize="11" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="✕" Click="BtnClose_Click" 
                        Background="#EF4444" Foreground="White" Width="28" Height="28" 
                        FontSize="13" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                    </Button.Resources>
                </Button>
            </DockPanel>

            <!-- List of actions -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="pnlItems">
                    <!-- Dynamic items loaded from code-behind -->
                </StackPanel>
            </ScrollViewer>

            <!-- Footer / Clear button -->
            <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,15,0,0">
                <Button DockPanel.Dock="Left" Content="🗑️ Geçmişi Temizle" Click="BtnClear_Click" Padding="12,6" Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                </Button>
                <Button DockPanel.Dock="Right" Content="Kapat" Click="BtnClose_Click" Padding="15,6" Background="#64748B" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                </Button>
            </DockPanel>
        </Grid>
    </Border>
</Window>
